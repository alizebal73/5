<Window x:Class="GameNet.CustomerClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameNet 5 - ورود مشتری"
        Width="570" Height="500" MinWidth="500" MinHeight="440"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#101828" Foreground="#101828">
  <Grid Margin="24">
    <Border Background="#FFFFFF" CornerRadius="14" Padding="28">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
          <TextBlock Text="GameNet 5" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock Text="ورود مشتری با نام کاربری و رمز عبور" FontSize="14"
                     Foreground="#475467" Margin="0,7,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1">
          <Grid x:Name="LoginPanel">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSessionStarted}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="نام کاربری" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                       Padding="11" FontSize="15" Margin="0,0,0,15"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
              <TextBlock Text="رمز عبور" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <PasswordBox x:Name="PasswordInput" Padding="11" FontSize="15"
                           PasswordChanged="PasswordInput_OnPasswordChanged" Margin="0,0,0,18"/>
              <Button Content="ورود و شروع بازی" Command="{Binding LoginCommand}"
                      Padding="12" FontSize="15" FontWeight="SemiBold"
                      IsEnabled="{Binding CanSubmit}"/>
              <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318"
                         TextWrapping="Wrap" Margin="0,12,0,0"/>
              <TextBlock Text="{Binding StatusMessage}" Foreground="#475467"
                         TextWrapping="Wrap" Margin="0,8,0,0"/>
              <TextBlock Text="ورود با اعتبار پیش‌پرداختی انجام می‌شود. در صورت کافی نبودن اعتبار، شروع Session رد می‌شود."
                         FontSize="11" Foreground="#667085" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
          </Grid>

          <Grid x:Name="SessionPanel" Visibility="Collapsed">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSessionStarted}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="خوش آمدید" FontSize="25" FontWeight="Bold"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding DisplayName}" FontSize="18" Margin="0,8,0,22"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="زمان باقی‌مانده" FontSize="13" Foreground="#475467"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding RemainingTimeText}" FontSize="40" FontWeight="Bold"
                         Margin="0,4,0,12" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding StatusMessage}" Foreground="#475467"
                         TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400"/>
              <TextBlock Text="زمان و صورتحساب را سرور تعیین می‌کند. این پنجره به‌تنهایی قفل سیستم‌عامل ویندوز را کنترل نمی‌کند."
                         FontSize="11" Foreground="#667085" TextWrapping="Wrap" TextAlignment="Center"
                         Margin="0,18,0,0" MaxWidth="420"/>
            </StackPanel>
          </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="GameNet 5 • Customer Client" FontSize="10"
                   Foreground="#98A2B3" HorizontalAlignment="Center" Margin="0,22,0,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
