<Window x:Class="GameNet.Desktop.Features.Sessions.CustomerEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Customer.EntryDialogTitle}"
        Width="430" Height="245" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Padding="20" Background="#FFFFFF">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="StationPrompt" Grid.Row="0" FontSize="13" TextWrapping="Wrap"
                 Foreground="#344054" Margin="0,0,0,14"/>
      <TextBlock Grid.Row="1" Text="{DynamicResource Customer.EntryId}" FontWeight="SemiBold" Margin="0,0,0,5"/>
      <StackPanel Grid.Row="2">
        <TextBox x:Name="CustomerCodeInput" Padding="8" FontSize="14" MaxLength="40"/>
        <TextBlock x:Name="ValidationMessage" Foreground="#B42318" FontSize="11" Margin="0,5,0,0"/>
      </StackPanel>
      <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,15,0,0">
        <Button DockPanel.Dock="Right" Content="{DynamicResource Customer.EntryConfirm}"
                Padding="13,7" MinWidth="110" IsDefault="True" Click="Confirm_Click"/>
        <Button DockPanel.Dock="Right" Content="{DynamicResource Customer.EntryCancel}"
                Padding="13,7" Margin="0,0,8,0" MinWidth="90" IsCancel="True"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
