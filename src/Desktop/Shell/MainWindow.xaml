<Window x:Class="GameNet.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}"
        Width="1180"
        Height="720"
        MinWidth="1000"
        MinHeight="650">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock Text="{DynamicResource App.Title}" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1"
               Margin="0,24,0,0"
               Text="{DynamicResource App.Welcome}"
               FontSize="18"/>
  </Grid>
</Window>
