<Window x:Class="GameNet.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}"
        Width="1360"
        Height="820"
        MinWidth="1120"
        MinHeight="700"
        Background="#F3F5F9"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="NavigationButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#475467" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F4F9" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="#E8EEFF" />
          <Setter Property="Foreground" Value="#2447A8" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#2547A8" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="246" />
      <ColumnDefinition Width="18" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="White"
            CornerRadius="18"
            Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="5,5,5,24">
          <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="11" Background="#2547A8">
              <TextBlock Text="G5"
                         Foreground="White"
                         FontWeight="Bold"
                         FontSize="15"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource App.Title}"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="#182230" />
              <TextBlock Text="{DynamicResource App.Welcome}"
                         FontSize="11"
                         Foreground="#667085"
                         Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{DynamicResource Nav.Workspace}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="#98A2B3"
                   Margin="10,0,10,8" />

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding NavigationItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Title}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{Binding Key}"
                        Style="{StaticResource NavigationButtonStyle}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="#F7F8FC"
                CornerRadius="11"
                Padding="11"
                Margin="2,14,2,2">
          <StackPanel>
            <TextBlock Text="{DynamicResource Footer.Baseline}"
                       FontSize="11"
                       Foreground="#667085"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding ServerStatusText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#344054"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="68" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="4,0,4,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding ActiveSectionTitle}"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="#182230" />
          <TextBlock Text="{Binding ActiveSectionDescription}"
                     FontSize="12"
                     Foreground="#667085"
                     Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Column="1"
                Background="White"
                BorderBrush="#E4E7EC"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,8"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="#98A2B3" Margin="0,0,8,0" />
            <TextBlock Text="{Binding ServerStatusText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Foreground" Value="#667085" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ServerStatusKind}" Value="ready">
                      <Setter Property="Foreground" Value="#16794B" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ServerStatusKind}" Value="notready">
                      <Setter Property="Foreground" Value="#B54708" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ServerStatusKind}" Value="offline">
                      <Setter Property="Foreground" Value="#B42318" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <StackPanel Visibility="{Binding IsOverview, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#182A59"
                    CornerRadius="18"
                    Padding="26"
                    Margin="2,0,2,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Home.Greeting}"
                             FontSize="26"
                             FontWeight="Bold"
                             Foreground="White" />
                  <TextBlock Text="{DynamicResource Home.Description}"
                             FontSize="14"
                             Foreground="#DCE5FF"
                             TextWrapping="Wrap"
                             Margin="0,10,0,0"
                             MaxWidth="650" />
                </StackPanel>
                <Border Grid.Column="1"
                        Width="72"
                        Height="72"
                        CornerRadius="18"
                        Background="#2D4275"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0">
                  <TextBlock Text="G5"
                             FontSize="26"
                             FontWeight="Bold"
                             Foreground="White"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>

            <Grid Margin="2,0,2,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0"
                      Background="White"
                      BorderBrush="#E4E7EC"
                      BorderThickness="1"
                      CornerRadius="16"
                      Padding="22">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Home.ServerConnection}"
                             FontSize="17"
                             FontWeight="Bold"
                             Foreground="#182230" />
                  <TextBlock Text="{DynamicResource Home.ServerDescription}"
                             FontSize="12"
                             Foreground="#667085"
                             TextWrapping="Wrap"
                             Margin="0,6,0,18" />

                  <Border Background="#F8FAFC"
                          BorderBrush="#EAECF0"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="16">
                    <StackPanel>
                      <TextBlock Text="{Binding ServerStatusText}"
                                 FontSize="20"
                                 FontWeight="Bold"
                                 Foreground="#344054" />
                      <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                          <TextBlock Text="{DynamicResource Home.ServerVersion}"
                                     FontSize="11"
                                     Foreground="#667085" />
                          <TextBlock Text="{Binding ServerVersionText}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="#344054"
                                     Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                          <TextBlock Text="{DynamicResource Home.LastChecked}"
                                     FontSize="11"
                                     Foreground="#667085" />
                          <TextBlock Text="{Binding LastCheckedText}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="#344054"
                                     Margin="0,4,0,0" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Button Content="{DynamicResource Home.Refresh}"
                          Command="{Binding RefreshServerCommand}"
                          Style="{StaticResource PrimaryButtonStyle}"
                          HorizontalAlignment="Left"
                          Margin="0,16,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2"
                      Background="White"
                      BorderBrush="#E4E7EC"
                      BorderThickness="1"
                      CornerRadius="16"
                      Padding="22">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Home.ScopeTitle}"
                             FontSize="17"
                             FontWeight="Bold"
                             Foreground="#182230" />
                  <TextBlock Text="{DynamicResource Home.ScopeDescription}"
                             FontSize="12"
                             Foreground="#667085"
                             TextWrapping="Wrap"
                             Margin="0,7,0,16" />
                  <Border Background="#FFF8EB"
                          BorderBrush="#F7D9A8"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="13">
                    <TextBlock Text="{DynamicResource Home.NoFakeData}"
                               FontSize="12"
                               Foreground="#7A4B0E"
                               TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <Border Visibility="{Binding IsSectionPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Background="White"
                  BorderBrush="#E4E7EC"
                  BorderThickness="1"
                  CornerRadius="18"
                  Padding="32"
                  Margin="2,0,2,16">
            <StackPanel VerticalAlignment="Center" MaxWidth="700">
              <Border Width="58"
                      Height="58"
                      CornerRadius="15"
                      Background="#E8EEFF"
                      HorizontalAlignment="Left">
                <TextBlock Text="G5"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#2547A8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{DynamicResource Section.InDevelopment}"
                         FontSize="22"
                         FontWeight="Bold"
                         Foreground="#182230"
                         Margin="0,22,0,8" />
              <TextBlock Text="{Binding ActiveSectionTitle}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="#344054" />
              <TextBlock Text="{DynamicResource Section.Description}"
                         FontSize="13"
                         Foreground="#667085"
                         TextWrapping="Wrap"
                         Margin="0,10,0,20" />
              <Button Content="{DynamicResource Section.BackToOverview}"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="overview"
                      Style="{StaticResource PrimaryButtonStyle}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
