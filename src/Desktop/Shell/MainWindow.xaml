<Window x:Class="GameNet.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}" Width="1180" Height="720" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F3F5F9">
  <Window.Resources>
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,6,0,16"/><Setter Property="MinWidth" Value="320"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinWidth" Value="140"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,22">
      <TextBlock Text="{DynamicResource App.Title}" FontSize="28" FontWeight="Bold" Foreground="#182230"/>
      <TextBlock Text="{DynamicResource App.Welcome}" FontSize="14" Margin="0,6,0,0" Foreground="#5B6574"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Border Padding="34" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="White" CornerRadius="16" BorderBrush="#DCE2EA" BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Text="{DynamicResource Identity.LoginTitle}" FontSize="24" FontWeight="Bold" Margin="0,0,0,26" Foreground="#182230"/>
          <TextBlock Text="{DynamicResource Identity.Username}" FontWeight="SemiBold"/>
          <TextBox Style="{StaticResource FieldBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{DynamicResource Identity.Password}" FontWeight="SemiBold"/>
          <PasswordBox x:Name="PasswordInput" FontSize="16" Padding="12,9" Margin="0,6,0,16"
                       MinWidth="320" PasswordChanged="PasswordInput_OnPasswordChanged"/>
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,14"/>
          <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Identity.LoginButton}" Command="{Binding LoginCommand}"/>
          <TextBlock Text="{DynamicResource Identity.LoginHint}" FontSize="12" Foreground="#667085" TextWrapping="Wrap" Margin="0,18,0,0"/>
        </StackPanel>
      </Border>
      <Border Padding="34" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Background="White" CornerRadius="16" BorderBrush="#DCE2EA" BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel LastChildFill="False" Margin="0,0,0,28">
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="{DynamicResource Identity.SignedIn}" FontSize="13" Foreground="#667085"/>
              <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="Bold" Foreground="#182230" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding CurrentUsername}" FontSize="13" Foreground="#667085"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                    Content="{DynamicResource Identity.LogoutButton}" Command="{Binding LogoutCommand}"/>
          </DockPanel>
          <Border Grid.Row="1" Padding="24" Background="#F8FAFC" CornerRadius="12">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Identity.LoginSucceeded}" FontSize="22" FontWeight="SemiBold" Foreground="#182230" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding StatusMessage}" FontSize="15" Foreground="#475467" Margin="0,14,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
